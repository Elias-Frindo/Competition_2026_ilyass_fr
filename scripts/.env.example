# ── KWRT live demo — environment template ─────────────────────────────────
# Copy this file to .env in the PROJECT ROOT (not in scripts/) and fill in the
# seller account. NEVER commit .env: it holds private keys.
#
#   cp scripts/.env.example .env
#
# Use an ECDSA (secp256k1) Hedera testnet key. The live demo reaches testnet
# through the HashIO JSON-RPC relay, which addresses accounts by their EVM
# (secp256k1) address, so ED25519 keys cannot be used for signing here.

# Seller / treasury — "Atlas Wind Energy". Holds the KWRT supply.
# SELLER_ID and SELLER_KEY fall back to OPERATOR_ID / OPERATOR_KEY.
SELLER_ID=0.0.XXXXXXX
SELLER_KEY=0x...            # ECDSA private key (DER or raw hex) — SECRET

# Client — "KWRT Demo Client". Leave both unset on the first run:
# setup:live creates the account, funds it with HBAR, associates KWRT and
# writes CLIENT_ID / CLIENT_KEY back into .env.
CLIENT_ID=
CLIENT_KEY=

# Written by setup:live when a KWRT token is created. Safe to leave empty.
KWRT_TOKEN_ID=
KWRT_MINT_TX=

# Local relay (server/relay.mjs) — serves the site and the live API.
RELAY_PORT=8787
